{
  "schemaVersion": 1,
  "scope": "entire-application-and-operating-organization",
  "releasePolicy": "independent-evidence-required",
  "certificationStatus": "not-certified",
  "controls": [
    {
      "id": "CMP-01",
      "framework": "ISO/IEC 27001:2022",
      "objective": "ISMS scope, leadership, risk assessment, treatment and statement of applicability",
      "ownerRole": "Information Security Lead",
      "requiredEvidence": [
        "Approved scope and risk methodology",
        "Risk register and treatment plan",
        "Statement of applicability against licensed standard",
        "Management review and independent internal audit"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-02",
      "framework": "ISO/IEC 42001:2023",
      "objective": "AI management system, inventory, impact assessment, accountability, evaluation and lifecycle",
      "ownerRole": "AI Governance Lead",
      "requiredEvidence": [
        "Approved AI policy and inventory",
        "AI impact and risk assessment",
        "Provider due diligence and evaluation",
        "Independent management system audit"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-03",
      "framework": "ISO/IEC 25010:2023",
      "objective": "Product quality across functional suitability, performance, compatibility, interaction, reliability, security, maintainability, flexibility and safety",
      "ownerRole": "Product Quality Lead",
      "requiredEvidence": [
        "Quality requirements mapped to complete journeys",
        "Measured acceptance and reliability",
        "Maintainability and recovery evidence"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-04",
      "framework": "WCAG 2.2 AA",
      "objective": "Full pages and complete processes, including error and authentication flows",
      "ownerRole": "Accessibility Lead",
      "requiredEvidence": [
        "Criterion-level automated and manual assessment",
        "Assistive technology and keyboard testing",
        "Complete journey conformance assessment"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-05",
      "framework": "OWASP ASVS 5.0.0 Level 2 target",
      "objective": "Application security requirements including identity, access, data, APIs and business logic",
      "ownerRole": "Application Security Lead",
      "requiredEvidence": [
        "Requirement-level applicability and verification",
        "Independent penetration testing",
        "Two-tenant live access tests and remediation"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-06",
      "framework": "NIST SSDF SP 800-218",
      "objective": "Secure development governance, protected source, secure production and vulnerability response",
      "ownerRole": "DevSecOps Lead",
      "requiredEvidence": [
        "Reviewed SBOM and provenance",
        "Protected branches and independent approval",
        "Vulnerability handling and secure release evidence"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-07",
      "framework": "Saudi PDPL and implementing regulations",
      "objective": "Controller/processor obligations, processing records, rights, transfer and retention assessment",
      "ownerRole": "Privacy Lead",
      "requiredEvidence": [
        "Legal applicability and controller/processor roles",
        "Processing register and lawful basis",
        "Rights requests, retention and deletion verification",
        "Cross-border transfer and supplier review"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-08",
      "framework": "Core Web Vitals",
      "objective": "Field p75 LCP, INP and CLS by device class",
      "ownerRole": "Performance Lead",
      "requiredEvidence": [
        "Production-like field measurement with privacy controls",
        "Measured p75 LCP/INP/CLS and budgets"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-09",
      "framework": "Internationalization and compatibility",
      "objective": "Complete English/Arabic workflows, browsers, devices and formats",
      "ownerRole": "Localization and QA Lead",
      "requiredEvidence": [
        "Reviewed translations and legal terminology",
        "Chromium Firefox WebKit and physical device tests",
        "Date, number, currency and RTL acceptance"
      ],
      "status": "not-accepted"
    },
    {
      "id": "CMP-10",
      "framework": "Independent certification and release",
      "objective": "Scope-specific accredited certification and release authorization",
      "ownerRole": "Executive Sponsor",
      "requiredEvidence": [
        "Legal entity and audit scope approved",
        "Accredited certification body engagement",
        "Stage 1 and Stage 2 audit and findings closure",
        "Valid certificate and independently approved release"
      ],
      "status": "not-accepted"
    }
  ],
